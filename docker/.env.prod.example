# ============================================================
# Шаблон переменных окружения для продакшена
# ============================================================
# Скопировать в docker/.env.prod и заполнить реальными значениями.
# Права файла: chmod 600 .env.prod
# ============================================================

# ----- Приложение -----
APP_ENV=production
APP_DEBUG=false
APP_NAME="TechBlog"
APP_URL=https://your-domain.com
APP_KEY=

# ----- Время -----
TZ=Europe/Moscow

# ----- База данных (MySQL 8.0) -----
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laraorchid
DB_USERNAME=laravel
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# ----- Очередь / Кэш / Сессия -----
QUEUE_CONNECTION=database
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ----- Логирование -----
LOG_CHANNEL=daily
LOG_LEVEL=info

# ----- Почта (SMTP) -----
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=changeme_mail
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ----- Сайт / соцсети -----
MY_GITHUB=
MY_TELEGRAM=
CONTACT_EMAIL=noreply@your-domain.com
SLOGAN=
SUB_LOGO=

# ----- SEO -----
SEO_DEFAULT_TITLE=
SEO_DEFAULT_DESCRIPTION=

# ----- Оператор ПДн (152-ФЗ, обязательно до публичного запуска) -----
OPERATOR_NAME=ООО «Оператор»
OPERATOR_ADDRESS=123456, г. Город, ул. Улица, д. 1
OPERATOR_INN=1234567890
OPERATOR_OGRN=1234567890123
OPERATOR_EMAIL=operator@example.com
OPERATOR_PHONE=+7 (000) 000-00-00
HOSTING_PROVIDER=

# ----- Админка Orchid -----
PLATFORM_PREFIX=/nexus

# ----- Доверенные прокси (reverse proxy / CDN) -----
# Если TLS терминируется на этом же хосте — оставьте '*'
# Для Cloudflare укажите CIDR-диапазоны IP Cloudflare
TRUSTED_PROXIES=*
