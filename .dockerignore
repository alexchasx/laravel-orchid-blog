# ---------------------------------------------------------------------------
# .dockerignore — что НЕ попадает в контекст сборки продакшн-образа.
# Dockerfile.prod выполняет COPY ./ /var/www с контекстом = корень репозитория,
# поэтому без этого файла в образ уедут .git, .env и docker/.env.prod (секреты),
# vendor/, node_modules/ (сотни МБ) и runtime-данные storage/.
# ---------------------------------------------------------------------------

# VCS и инструменты разработки
.git
.github
.idea
.vscode
.codeassistant
.gigacode*
opencode.json

# Секреты и окружение: в образе не нужны (переменные рантайма приходят
# через env_file из docker/.env.prod на сервере)
.env
.env.*
docker/env.prod*

# Зависимости — устанавливаются на этапе сборки образа
vendor
node_modules

# Локальные данные и кэши (runtime-данные живут в volume app_storage;
# public/build собирается стадией node_builder, public/storage создаёт
# `php artisan storage:link` на этапе сборки)
storage

# Скомпилированные кэши Laravel (bootstrap/cache/packages.php и services.php).
# В dev-окружении в манифест попадают dev-only провайдеры (laravel-lang), а в
# прод-образ зависимости ставятся с --no-dev: устаревший манифест ломает загрузку
# приложения ещё до artisan («Class "LaravelLang\Config\ServiceProvider" not
# found»). Каталог создаётся в Dockerfile.prod и наполняется `package:discover`.
bootstrap/cache
docker/tmp
public/build
public/hot
public/storage

# Dev-артефакты и документация
tests
docs
plans
prompts
screenshots
.phpunit.result.cache
npm-debug.log
yarn-error.log
composer.phar
Homestead.json
Homestead.yaml
