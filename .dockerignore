# ============================================================
# Контекст сборки Docker (контекст — корень репозитория)
# ============================================================
# Файлы и каталоги ниже НЕ попадают в образ. Задача — не тащить в
# продакшн-образ мусор сборки и секреты. Пути относительные корня репо.

# Система контроля версий и служебное
.git
.gitignore
.gitattributes
.styleci.yml

# Локальные настройки и секреты (в образ не попадают, приходят через env_file)
.env
.env.*
.phpunit.result.cache
phpunit.xml
phpunit.xml.dist

# Зависимости ставятся внутри образа (composer install / npm ci)
vendor
node_modules
**/node_modules

# Артефакты сборки фронтенда — пересобираются в стадии node_builder
public/build
public/hot

# Логи, кэш и загруженные пользователями данные рантайма — в проде живут в
# volume app_storage, в образ не попадают (нужные каталоги создаёт Dockerfile).
# Игнорируем всё дерево storage/: отдельные подкаталоги вроде
# storage/app/articles могут иметь режим 0700 и ронять сборку контекста.
storage/*
bootstrap/cache/*

# Тесты, скриншоты, рабочие документы — не нужны в проде
tests
screenshots
docs
plans
prompts

# Docker-специфичное (в код приложения не входит; сами Dockerfile читаются
# из контекста, поэтому каталог docker/ НЕ исключаем целиком)
docker/tmp
