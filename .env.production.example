# ============================================================
# Шаблон .env для размещения на VPS (Production)
# ============================================================
# Скопируйте этот файл как .env и заполните реальными значениями.
# Права на готовый файл: chmod 600 .env
# ============================================================

APP_NAME=TECH//LOG
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# SEO-метаданные по умолчанию (используются в layouts/techlog.blade.php)
SEO_DEAFULT_TITLE=TECH//LOG — ИТ-блог
SEO_DEAFULT_DESCRIPTION=ИТ-блог о технологиях, архитектуре, инструментах и практических решениях для современного разработчика.

# Соцсети и контакты
MY_GITHUB=https://github.com/
MY_EMAIL=
MY_TELEGRAM=
SLOGAN=
CONTACT_EMAIL=info@your-domain.com
SUB_LOGO=

# ============================================================
# База данных (MySQL 8.0)
# ============================================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laraorchid
DB_USERNAME=blog_user
DB_PASSWORD=

# ============================================================
# Кэш / сессия / очередь
# ============================================================
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Рассылка писем подписчикам идёт через очередь (Mailable NewArticleMail
# implements ShouldQueue). Рабочий процесс — контейнер blog_queue.
# Для прода используйте реальный SMTP-провайдер.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# Логирование
# ============================================================
LOG_CHANNEL=daily
LOG_LEVEL=info

# ============================================================
# Админ-панель Orchid
# ============================================================
PLATFORM_PREFIX=/nexus

# ============================================================
# Прокси / CDN (доверенные заголовки X-Forwarded-*)
# ============================================================
# Если TLS терминируется хостовым nginx/caddy/Cloudflare — Laravel
# должен доверять заголовкам прокси, иначе абсолютные URL (canonical,
# OG, sitemap, storage) будут HTTP.
# '*' — для reverse-proxy на том же хосте; для Cloudflare используйте
# список IP-диапазонов (см. docs/architecture.md, раздел 2.5).
TRUSTED_PROXIES=*

# ============================================================
# Оператор персональных данных (152-ФЗ)
# ============================================================
# Обязательны до публичного запуска — подставляются в тексты согласий.
OPERATOR_NAME=""
OPERATOR_ADDRESS=""
OPERATOR_INN=""
OPERATOR_OGRN=""
OPERATOR_EMAIL=""
OPERATOR_PHONE=""
HOSTING_PROVIDER=""

# ============================================================
# Ниже — стандартные переменные Laravel (не обязательны для прода)
# ============================================================
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

MEMCACHED_HOST=memcached

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SCOUT_DRIVER=null
